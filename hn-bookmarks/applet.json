{
  "schemaVersion": 6,
  "id": "hn-bookmarks",
  "name": "Hacker News",
  "origins": [
    "https://news.ycombinator.com",
    "https://hn.algolia.com"
  ],
  "foreground": {
    "kind": "web",
    "entry": "index.html"
  },
  "contexts": [
    {
      "id": "primary",
      "startUrl": "https://news.ycombinator.com/"
    },
    {
      "id": "post",
      "startUrl": "https://news.ycombinator.com/submit"
    },
    {
      "id": "me",
      "startUrl": "https://news.ycombinator.com/news?account=1"
    }
  ],
  "capabilities": {
    "services": [
      {
        "id": "bookmarks",
        "config": "backend/service.json"
      }
    ]
  },
  "shell": {
    "accent": "#ff6600"
  },
  "build": {
    "foreground": {
      "entry": "src/main.tsx"
    },
    "page": "src/page.ts"
  }
}

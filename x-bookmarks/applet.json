{
  "schemaVersion": 6,
  "id": "x-bookmarks",
  "name": "X",
  "origins": [
    "https://x.com"
  ],
  "foreground": {
    "kind": "web",
    "entry": "index.html"
  },
  "contexts": [
    {
      "id": "primary",
      "startUrl": "https://x.com/home"
    },
    {
      "id": "explore",
      "startUrl": "https://x.com/explore"
    },
    {
      "id": "account",
      "startUrl": "https://x.com/settings/account"
    }
  ],
  "capabilities": {
    "storage": true,
    "services": [
      {
        "id": "bookmarks",
        "config": "backend/service.json"
      }
    ]
  },
  "shell": {
    "accent": "#1d9bf0",
    "icon": "assets/icon.png"
  },
  "build": {
    "foreground": {
      "entry": "src/main.tsx"
    },
    "page": "src/page.ts"
  }
}
